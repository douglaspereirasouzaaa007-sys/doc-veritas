modules = ["nodejs-20", "web", "python-base-3.13", "bun-1.3", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "NITRO_PORT=5000 node .output/server/index.mjs"]
build = ["bun", "run", "build"]
ignorePorts = false

[userenv]

[userenv.shared]
PUBLIC_SITE_URL = "https://memedsolutions.com"
VITE_PUBLIC_SITE_URL = "https://memedsolutions.com"
STORE_DATA_PATH = "/home/runner/workspace/data/store.json"
